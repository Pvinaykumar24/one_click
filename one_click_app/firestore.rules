rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user has admin custom claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Helper: Check if request is from the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Get user's profile document data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if authenticated user belongs to the target collegeId
    function isMemberOfCollege(collegeId) {
      return isAuthenticated() && (
        ('collegeId' in request.auth.token && request.auth.token.collegeId == collegeId) ||
        (getUserData().collegeId == collegeId) ||
        (getUserData().college == collegeId) ||
        (collegeId == 'iiitdm' && !('collegeId' in getUserData()) && !('college' in getUserData()))
      );
    }

    // Match app_config collection for In-App OTA Live Updates & Remote Config
    match /app_config/{document=**} {
      allow read, write: if true; // 100% open for real-time OTA updates & announcements
    }

    // Match users collection
    match /users/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Match institutions collection and all nested subcollections
    match /institutions/{collegeId} {
      allow read: if isMemberOfCollege(collegeId);
      allow write: if isAdmin() && isMemberOfCollege(collegeId);

      match /messMenu/{document=**} {
        allow read: if isMemberOfCollege(collegeId);
        allow write: if isMemberOfCollege(collegeId);
      }

      match /{document=**} {
        allow read: if isMemberOfCollege(collegeId);
        allow write: if isAdmin() && isMemberOfCollege(collegeId);
      }
    }
  }
}
